# Copy to /etc/idata/idata-server.env and replace the admin token.
# Optional legacy shared Client credential. New Clients use administrator-approved enrollment.
IDATA_AGENT_TOKEN=
IDATA_ADMIN_TOKEN=replace-with-web-admin-token
# Leave empty to use :12345 on 10.90.65.189 and :80 on other hosts.
IDATA_LISTEN_ADDR=
IDATA_DEVICE_CREDENTIALS_FILE=/var/lib/idata/device-credentials.json
# Automatically issue a unique device credential to every valid native Client request.
# This deployment must remain restricted to the trusted company network. Set false for manual approval.
IDATA_ENROLLMENT_AUTO_APPROVE=true
# Source IP discovers candidates only; Windows local confirmation is always required.
IDATA_BROWSER_PAIRING=false
IDATA_PAIRING_REQUEST_TTL=2m
IDATA_DEVICE_SESSION_TTL=8h
